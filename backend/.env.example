# ✅ VARIABLES D'ENVIRONNEMENT POUR POKEMON BATTLE APP
# ⚠️  IMPORTANT: Copiez ce fichier vers .env et remplissez vos vraies valeurs
# ❌ NE JAMAIS COMMITTER LE FICHIER .env AVEC VOS VRAIES VALEURS

# 🔑 JWT SECRET POUR L'AUTHENTIFICATION (OBLIGATOIRE)
# ⚠️  Génération OBLIGATOIRE : openssl rand -hex 32
# ❌ NE JAMAIS UTILISER LA VALEUR D'EXEMPLE EN PRODUCTION
JWT_SECRET=CHANGEZ_MOI_GENEREZ_UNE_CLE_ALEATOIRE_DE_32_CARACTERES_MINIMUM

# 📄 CONFIGURATION BASE DE DONNÉES (OBLIGATOIRE)
# ⚠️  Changez les mots de passe par défaut
DATABASE_URL=postgresql://pokemon_user:CHANGEZ_MOI_MOT_DE_PASSE@localhost:5432/pokemon_battle
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pokemon_battle
DB_USER=pokemon_user
DB_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE

# 🌍 OPENWEATHERMAP API KEY (OPTIONNEL)
# Obtenez votre clé gratuite sur : https://openweathermap.org/api
# 1000 appels/jour gratuits
OPENWEATHER_API_KEY=

# 📋 CONFIGURATION SERVEUR
NODE_ENV=development
PORT=3001

# 🔒 CONFIGURATION SÉCURITÉ
# URL autorisée pour CORS (changez en production)
CORS_ORIGIN=http://localhost:3000

# 🐳 CONFIGURATION DOCKER
DOCKER_AUTO_SEED=true
FIRST_INSTALL_THRESHOLD=0

# 📈 CONFIGURATION PRODUCTION (si applicable)
# Décommentez et configurez pour la production
# CORS_ORIGIN=https://votre-domaine.com
# NODE_ENV=production
# PORT=3001
